# Multi-stage build for the worker pool — MASTER_PLAN Task 0.9 (skeleton).
# Workers need FFmpeg + yt-dlp at runtime; those system deps are added in Sprint 6.
# Final image is slim. Runtime entrypoint (workers/main.py) lands in Sprint 6.

# ---- builder ----
FROM python:3.13-slim AS builder
WORKDIR /build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# The project declares explicit packages (api/bot/core/domain/infrastructure/
# services/workers), so building the wheel needs the full source in the build
# context — copy it all, then install (this pulls the runtime deps into /install
# too). A .dockerignore keeps .git/.venv/.env/caches out of the context.
COPY . .
RUN python -m pip install --upgrade pip \
    && pip install --prefix=/install .

# ---- final ----
FROM python:3.13-slim AS final
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Runtime binaries the download pipeline shells out to (neither is imported as a
# Python module):
#   * ffmpeg — the transcoder (FFMPEG_PATH).
#   * yt-dlp — the downloader; YtDlpProvider wraps the `yt-dlp` binary (YTDLP_PATH),
#     so the image MUST ship it or every download fails with "yt-dlp not found".
# yt-dlp is pinned exactly (§6.4) and date-versioned — bump on the agreed cadence
# (OQ-9). Installed via pip so the `yt-dlp` console script lands on PATH.
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir yt-dlp==2026.7.4

RUN useradd --create-home --uid 10001 appuser
COPY --from=builder /install /usr/local
COPY . .
# JS runtime for yt-dlp YouTube signature/n-challenge solving (EJS).
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno
# Ensure the scratch download dir is writable by the runtime user (D: volume inherits this on first mount).
RUN mkdir -p /tmp/downloads && chown appuser:appuser /tmp/downloads
# Install the yt-dlp cookie wrapper (private writable cookie copy per run).
RUN mv /usr/local/bin/yt-dlp /usr/local/bin/yt-dlp.real && install -m 0755 /app/deploy/ytdlp-wrapper.sh /usr/local/bin/yt-dlp
RUN pip install --no-cache-dir bgutil-ytdlp-pot-provider
USER appuser

# Composition root: builds the worker pool + maintenance loops (honours WORKER_COUNT).
CMD ["python", "-m", "workers.main"]
