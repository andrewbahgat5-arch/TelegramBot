# Multi-stage build for the Telegram bot process — MASTER_PLAN Task 0.9 (skeleton).
# Final image is slim. Runtime entrypoint (bot/main.py) lands in Sprint 4.

# ---- builder ----
FROM python:3.13-slim AS builder
WORKDIR /build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# The project declares explicit packages (api/bot/core/domain/infrastructure/
# services/workers), so building the wheel needs the full source in the build
# context — copy it all, then install into an isolated prefix copied into the
# final stage. A .dockerignore keeps .git/.venv/.env/caches out of the context.
COPY . .
RUN python -m pip install --upgrade pip \
    && pip install --prefix=/install .

# ---- final ----
FROM python:3.13-slim AS final
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# The URL-analysis step (URLAnalyzerService → YtDlpProvider.extract_info) shells
# out to the yt-dlp binary in the bot process (to show format/quality options
# before enqueuing the job), so the bot image needs yt-dlp too. Pinned exactly
# (§6.4), bump per OQ-9. No ffmpeg — the bot only reads metadata; the actual
# download + transcode (which needs ffmpeg) runs in the worker.
RUN pip install --no-cache-dir yt-dlp==2026.7.4

# Non-root runtime user.
RUN useradd --create-home --uid 10001 appuser
COPY --from=builder /install /usr/local
COPY . .
USER appuser

# Composition root: builds the dispatcher + runs long-polling (webhook optional).
CMD ["python", "-m", "bot.main"]
