          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"Time\", severity AS \"Sev\", category AS \"Category\", platform AS \"Platform\", url AS \"URL\", username AS \"User\", user_id AS \"UserID\", chat_id AS \"Chat\", message AS \"Message\", context AS \"Context\" FROM error_logs WHERE $__timeFilter(created_at) AND (severity IS NULL OR severity IN ('warning','info')) AND ('$severity' = '__all' OR severity = '$severity') AND ('$platform' = '__all' OR platform = '$platform') ORDER BY created_at DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
