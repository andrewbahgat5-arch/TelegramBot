# =============================================================================
# PRODUCTION environment file — MASTER_PLAN §13.2 (LOCKED key set), Sprint 12 A2.
#
# This is the app-config file loaded by `deploy/docker-compose.prod.yml`
# (`env_file: .env.production`) into the bot / worker / api containers.
#
#   cp .env.production.example .env.production   # then fill REAL values
#   # NEVER commit .env.production — it is gitignored.
#
# SECRETS ARE PLACEHOLDERS HERE. In production, inject real secrets from the
# orchestrator's secret backend, not from a file on disk:
#   BOT_TOKEN, BOT_WEBHOOK_SECRET, DB_PASSWORD, SENTRY_DSN, ADMIN_API_KEY,
#   TELEGRAM_API_HASH.
#
# Key set is IDENTICAL to `.env.example` (the LOCKED §13.2 set) — same keys,
# production-appropriate values. Descriptions live on their own comment lines so
# every dotenv loader parses empty-valued keys cleanly.
#
# Infra note: the DB path is FORCED through PgBouncer by the compose x-app anchor
# (DB_HOST=pgbouncer, DB_PORT=6432, D-020), so the DB_HOST/DB_PORT you set below
# are overridden for the app containers. DB_NAME/DB_USER/DB_PASSWORD are read by
# BOTH the app (from this file) AND compose interpolation for the postgres/
# pgbouncer containers (from the shell env or `deploy/.env`) — keep them in sync.
# =============================================================================

# --- Telegram bot ---------------------------------------------------------
# BOT_TOKEN: required, secret, never logged. Inject from the secret backend.
BOT_TOKEN=__SET_IN_SECRET_BACKEND__
# BOT_WEBHOOK_URL: leave empty for long-polling (V1 default). Set to the public
# HTTPS webhook URL to switch to webhook mode.
BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET: required (secret) ONLY when BOT_WEBHOOK_URL is set.
BOT_WEBHOOK_SECRET=
# BOT_OWNER_TELEGRAM_ID: required, the hard owner id (numeric Telegram user id).
BOT_OWNER_TELEGRAM_ID=0
BOT_PARSE_MODE=HTML
# BOT_API_BASE_URL: empty → public api.telegram.org (50 MB upload cap). Set to
# http://bot-api:8081 AND enable the compose `bot-api` profile for the 2 GB cap
# (D-040, deploy/LOCAL_BOT_API.md). Leave empty unless you run the self-hosted server.
BOT_API_BASE_URL=

# --- Deployment environment / test isolation (D-060, D-032) ---------------
# DEPLOY_ENV: development | test | production. MUST be `production` here.
DEPLOY_ENV=production
# PROD_BOT_TOKEN_FINGERPRINT: only meaningful when DEPLOY_ENV=test (guards a test
# process from booting with the real prod token). Leave empty in production.
PROD_BOT_TOKEN_FINGERPRINT=

# --- Database (PostgreSQL 15+) --------------------------------------------
# DB_HOST/DB_PORT below are OVERRIDDEN to pgbouncer:6432 by the compose x-app
# anchor (D-020). Keep them as the pooler for clarity; direct-Postgres is refused.
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=telegram_bot
DB_USER=telegram_bot
# DB_PASSWORD: required, secret. Must match the value compose passes to the
# postgres/pgbouncer containers (shell env or deploy/.env).
DB_PASSWORD=__SET_IN_SECRET_BACKEND__
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# DB_SSL: true if Postgres enforces TLS (recommended when not on a private network).
DB_SSL=false

# --- Redis (cache + queue) ------------------------------------------------
# REDIS_URL: internal service name in the prod stack. Include auth if enabled.
REDIS_URL=redis://redis:6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# --- Workers --------------------------------------------------------------
# WORKER_COUNT: in-process workers per worker container. Tune to host CPU.
WORKER_COUNT=3
# WORKER_JOB_TIMEOUT: seconds.
WORKER_JOB_TIMEOUT=300
# WORKER_HEARTBEAT_INTERVAL: seconds.
WORKER_HEARTBEAT_INTERVAL=30
WORKER_MAX_RETRIES=3

# --- Download / media toolchain -------------------------------------------
# DOWNLOAD_TEMP_DIR: mounted as the `downloads` scratch volume in prod compose.
DOWNLOAD_TEMP_DIR=/tmp/downloads
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Per-platform egress (infrastructure/downloader/routing.py). YouTube metadata always
# goes over WARP; YouTube downloads use WARP up to YTDLP_WARP_MAX_DOWNLOAD_MB and the
# residential proxy above it (WARP is bandwidth-capped and cannot use aria2c).
# YTDLP_PROXY is a SECRET — set the real value in .env.production, never here.
YTDLP_PROXY=
YTDLP_WARP_PROXY=socks5://warp-lb:1080
YTDLP_WARP_MAX_DOWNLOAD_MB=500
# Cookie pool (DESIGN_COOKIE_POOL.md). Material is server-only, never committed.
YTDLP_COOKIE_POOL_DIR=/etc/yt-dlp/cookies.d
YTDLP_COOKIE_LEGACY_FILE=/etc/yt-dlp/cookies.txt
YTDLP_COOKIE_CANARY_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# --- Cache TTLs (seconds) -------------------------------------------------
# CACHE_FILEID_TTL: 30 days.
CACHE_FILEID_TTL=2592000
# CACHE_METADATA_TTL: 1 hour.
CACHE_METADATA_TTL=3600
# CACHE_USER_TTL: D-014.
CACHE_USER_TTL=30
CACHE_LOCK_TTL=600
CACHE_SETTINGS_TTL=60

# --- Error tracking (Sentry) ----------------------------------------------
# SENTRY_DSN: secret. Empty → Sentry disabled. Fill once OQ-1 (self-hosted vs
# SaaS + per-env DSN) is decided; inject from the secret backend.
SENTRY_DSN=
# SENTRY_ENVIRONMENT: set to `production` so events are tagged correctly.
SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE: lower in production to control cost/volume.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Logging --------------------------------------------------------------
# LOG_LEVEL: INFO in production (DEBUG is verbose and may log sensitive context).
LOG_LEVEL=INFO
# LOG_FORMAT: json in production (machine-parseable for the log pipeline).
LOG_FORMAT=json

# --- API (admin / health / metrics) --------------------------------------
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8080
# ADMIN_API_KEY: secret. Empty → the /v1/admin/* surface is disabled (404). The
# HTTP admin API (Task 8.3) is not served in V1 (deploy/README.md §1) — leave empty.
ADMIN_API_KEY=

# --- Alerting -------------------------------------------------------------
# TELEGRAM_ALERTS_CHAT_ID: dedicated owner-monitored alert chat id (OQ-5). Empty
# → no Telegram CRITICAL alerts. Set to the alerts chat once OQ-5 is decided.
TELEGRAM_ALERTS_CHAT_ID=

# --- Localization (Sprint 11.5) --------------------------------------------
# DEFAULT_LOCALE: reference/fallback locale (BCP-47); must match an enabled
# core/locales/*.json (_meta.enabled=true). en + ar ship enabled.
DEFAULT_LOCALE=en
