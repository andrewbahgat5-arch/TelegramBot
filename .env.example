# =============================================================================
# Example environment file — MASTER_PLAN Section 13.2 (LOCKED key set).
# Copy to `.env` and fill real values. NEVER commit a real `.env`.
# Secrets (BOT_TOKEN, DB_PASSWORD, SENTRY_DSN) must come from the orchestrator's
# secret backend in production, not from this file.
#
# Descriptions are on their own comment lines (not inline) so every dotenv
# loader parses values cleanly, including empty-valued keys.
# =============================================================================

# --- Telegram bot ---------------------------------------------------------
# BOT_TOKEN: required, secret, never logged.
BOT_TOKEN=bot-token-test-XXXX
# BOT_WEBHOOK_URL: leave empty for long-polling mode.
BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET: required only when BOT_WEBHOOK_URL is set.
BOT_WEBHOOK_SECRET=
# BOT_OWNER_TELEGRAM_ID: required, the hard owner id.
BOT_OWNER_TELEGRAM_ID=0
BOT_PARSE_MODE=HTML
# BOT_API_BASE_URL: empty → public api.telegram.org (50 MB cap). Set to a
# self-hosted Bot API server base URL (e.g. http://bot-api:8081) for the 2 GB
# cap (D-040).
BOT_API_BASE_URL=

# --- Deployment environment / test isolation (D-060, D-032) ---------------
# DEPLOY_ENV: development | test | production. `test` activates the isolation
# guards in Section 25.6 (e.g. the production-fingerprint boot assertion below).
DEPLOY_ENV=development
# PROD_BOT_TOKEN_FINGERPRINT: SHA-256 hex digest of the PRODUCTION bot token
# (a one-way hash, NOT the token). When DEPLOY_ENV=test and the running
# BOT_TOKEN hashes to this value, the process refuses to boot. Leave empty to
# disable the check. Compute with: core.security.token_fingerprint(<prod token>).
PROD_BOT_TOKEN_FINGERPRINT=

# --- Database (PostgreSQL 15+) --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telegram_bot
DB_USER=telegram_bot
# DB_PASSWORD: required, secret.
DB_PASSWORD=change-me-local
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL=false

# --- Redis (cache + queue) ------------------------------------------------
# REDIS_URL: required; include auth credentials in the URL if needed.
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# --- Workers --------------------------------------------------------------
WORKER_COUNT=3
# WORKER_JOB_TIMEOUT: seconds.
WORKER_JOB_TIMEOUT=300
# WORKER_HEARTBEAT_INTERVAL: seconds.
WORKER_HEARTBEAT_INTERVAL=30
WORKER_MAX_RETRIES=3

# --- Download / media toolchain -------------------------------------------
DOWNLOAD_TEMP_DIR=/tmp/downloads
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Per-platform egress (infrastructure/downloader/routing.py). Empty locally: dev has no
# proxy/WARP containers, so protected platforms fall back to a DIRECT attempt.
# YouTube metadata always uses WARP; downloads use WARP up to the MB split below and the
# residential proxy above it. YTDLP_PROXY is a SECRET — real value only in .env.
YTDLP_PROXY=
YTDLP_WARP_PROXY=
YTDLP_WARP_MAX_DOWNLOAD_MB=500

# --- Cache TTLs (seconds) -------------------------------------------------
# CACHE_FILEID_TTL: 30 days.
CACHE_FILEID_TTL=2592000
# CACHE_METADATA_TTL: 1 hour.
CACHE_METADATA_TTL=3600
# CACHE_USER_TTL: D-014.
CACHE_USER_TTL=30
CACHE_LOCK_TTL=600
CACHE_SETTINGS_TTL=60

# --- Error tracking (Sentry) ----------------------------------------------
# SENTRY_DSN: leave empty to disable Sentry.
SENTRY_DSN=
# SENTRY_ENVIRONMENT: development | staging | production.
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Logging --------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
# LOG_FORMAT: json | console.
LOG_FORMAT=json

# --- API (admin / health / metrics) --------------------------------------
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8080
# ADMIN_API_KEY: secret key for the HTTP admin API (/v1/admin/*, Section 20.3).
# Leave empty to disable the admin surface entirely (those paths return 404). When
# set, admin requests must send it in the `X-API-Key` header or receive 401.
ADMIN_API_KEY=

# --- Alerting -------------------------------------------------------------
# TELEGRAM_ALERTS_CHAT_ID: owner-monitored alert channel; leave empty if unused.
TELEGRAM_ALERTS_CHAT_ID=

# --- Localization (Sprint 11.5) --------------------------------------------
# DEFAULT_LOCALE: reference/fallback locale (BCP-47). Must match a discovered
# core/locales/*.json file with _meta.enabled=true.
DEFAULT_LOCALE=en
