# =============================================================================
# Example environment file — MASTER_PLAN Section 13.2 (LOCKED key set).
# Copy to `.env` and fill real values. NEVER commit a real `.env`.
# Secrets (BOT_TOKEN, DB_PASSWORD, SENTRY_DSN) must come from the orchestrator's
# secret backend in production, not from this file.
# =============================================================================

# --- Telegram bot ---------------------------------------------------------
BOT_TOKEN=bot-token-test-XXXX            # required · secret · never logged
BOT_WEBHOOK_URL=                         # empty -> long-polling mode
BOT_WEBHOOK_SECRET=                      # required only in webhook mode
BOT_OWNER_TELEGRAM_ID=0                  # required · hard owner id
BOT_PARSE_MODE=HTML

# --- Database (PostgreSQL 15+) --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telegram_bot
DB_USER=telegram_bot
DB_PASSWORD=change-me-local              # required · secret
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL=false

# --- Redis (cache + queue) ------------------------------------------------
REDIS_URL=redis://localhost:6379         # required · include auth if needed
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# --- Workers --------------------------------------------------------------
WORKER_COUNT=3
WORKER_JOB_TIMEOUT=300                    # seconds
WORKER_HEARTBEAT_INTERVAL=30              # seconds
WORKER_MAX_RETRIES=3

# --- Download / media toolchain -------------------------------------------
DOWNLOAD_TEMP_DIR=/tmp/downloads
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# --- Cache TTLs (seconds) -------------------------------------------------
CACHE_FILEID_TTL=2592000                  # 30 days
CACHE_METADATA_TTL=3600                    # 1 hour
CACHE_USER_TTL=30                          # D-014
CACHE_LOCK_TTL=600
CACHE_SETTINGS_TTL=60

# --- Error tracking (Sentry) ----------------------------------------------
SENTRY_DSN=                               # empty -> disabled
SENTRY_ENVIRONMENT=development            # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                           # json | console

# --- API (admin / health / metrics) --------------------------------------
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8080

# --- Alerting -------------------------------------------------------------
TELEGRAM_ALERTS_CHAT_ID=                  # owner-monitored alert channel
